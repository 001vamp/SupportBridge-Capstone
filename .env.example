# Copy to server/.env — see README.md "Local setup"
# For VITE_* variables, use client/.env (see client/.env.example)

PORT=3001
# Bind API on all interfaces so other devices on your LAN can reach it (default 0.0.0.0). Use 127.0.0.1 to block remote.
LISTEN_HOST=0.0.0.0
DATABASE_PATH=server/data/supportbridge.sqlite
# Production: exact allowed origin.
# Dev: backend allows localhost Vite ports plus private LAN IPs (10/8, 172.16-31, 192.168) on common dev ports.
CLIENT_ORIGIN=http://localhost:5173
HERMES_ENABLED=false
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
# Optional alias if you do not use HERMES_API_KEY:
HERMES_KEY=
HERMES_MODEL=hermes-agent
# Optional demo gate for reviewer REST actions and sockets. Leave blank for local no-auth demos.
REVIEWER_ACCESS_KEY=
VITE_REVIEWER_ACCESS_KEY=
# If the API is not on port 3001, set the same port here so the browser client can find it on your LAN.
# VITE_BACKEND_PORT=3001
