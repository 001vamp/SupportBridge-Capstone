# Copy to client/.env (Vite loads env from this folder).
# Only needed when using the reviewer demo gate or overriding API URLs.

# Must match REVIEWER_ACCESS_KEY in server/.env
VITE_REVIEWER_ACCESS_KEY=

# Optional: if the API is not on port 3001 on the same host as the browser
# VITE_BACKEND_PORT=3001

# Optional: full override (normally the app uses window.location.hostname:3001)
# VITE_API_BASE_URL=http://localhost:3001/api
# VITE_SOCKET_URL=http://localhost:3001
